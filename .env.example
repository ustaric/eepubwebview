# 서버 구동 포트 및 바인딩 호스트 (Caddy 리버스 프록시 연동 시 기본 127.0.0.1)
PORT=3001
HOST=127.0.0.1

# Google Cloud OAuth 2.0 Client 설정
# (Google Cloud Console의 사용자 인증 정보에서 발급받은 값)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Google OAuth Redirect URI (Google Cloud 승인된 리디렉션 URI와 완벽히 일치해야 함)
GOOGLE_REDIRECT_URI=https://주소/auth/google/callback

# Refresh Token AES-256-GCM 암호화 마스터 키 (32바이트 이상의 임의 문자열 권장)
TOKEN_ENCRYPTION_KEY=change-this-to-a-very-long-and-secure-random-secret-key-32-chars

# 암호화된 토큰 파일 저장 경로 (상대 경로 또는 절대 경로)
TOKEN_FILE=./data/token.enc

# CORS 허용 Origin (필요 시 지정, Caddy 동일 도메인 프록시 사용 시 비워둘 수 있음)
ALLOWED_ORIGIN=https://주소